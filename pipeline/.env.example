# Copy to pipeline/.env and fill in. `.env` is gitignored.
#
# NOTE: this file is dot-sourced by run_daily.sh. Any value that contains
# a space, quote, or shell metacharacter MUST be double-quoted, or bash
# will try to execute the second word as a command.

# Required — writer uses this for LLM calls.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — if left empty, run_daily.sh reads it from
# mcp_server/apple-notes/bridge/.secret automatically.
# NOTES_BRIDGE_SECRET=

# Optional overrides. Quote any value with spaces (e.g. folder names).
# WRITER_MODEL=anthropic:claude-sonnet-4-6
# LOOKBACK_HOURS=24
# TOPIC_LIMIT=5
# APPLE_NOTES_FOLDER="Daily Brief"
# TREND_RADAR_DB=/absolute/path/to/trend_radar.db
