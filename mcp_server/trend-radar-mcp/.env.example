# trend-radar environment. Copy to .env for local dev.
# In production, values are injected via `docker mcp secret set <NAME>`.

# --- Storage & logs -----------------------------------------------------
# SQLite ledger + run cache. Volume-mount this directory in Docker so
# coverage history survives container restarts.
# TREND_RADAR_LOG_DIR defaults to db_path.parent — override one, both move.
#
# In Docker (default):
TREND_RADAR_DB=/data/trend_radar.db
#
# For local dev, comment the line above and uncomment this:
# TREND_RADAR_DB=./data/trend_radar.db

# --- Clustering ---------------------------------------------------------
# If ANTHROPIC_API_KEY is absent, the server transparently falls back to
# lexical clustering. It stays fully functional.
ANTHROPIC_API_KEY=
TREND_RADAR_LLM_MODEL=anthropic:claude-sonnet-4-6

# --- Novelty ------------------------------------------------------------
# Optional embedding model for cosine-similarity novelty checks. If unset,
# the ledger uses rapidfuzz token_set_ratio.
TREND_RADAR_EMBED_MODEL=

# --- Ranking (all optional, defaults in code) ---------------------------
# Nested pydantic-settings: TREND_RADAR_SCORING__<FIELD>=<value>
# TREND_RADAR_SCORING__CORROBORATION_PER_SOURCE=0.15
# TREND_RADAR_SCORING__NOVELTY_FUZZ_THRESHOLD=88

# --- Runtime knobs ------------------------------------------------------
# Cap on RawItems retained per RankedTopic in the run cache.
TREND_RADAR_MAX_ITEMS_PER_TOPIC=5

# --- Observability (optional) -------------------------------------------
LOGFIRE_TOKEN=
